SIP_TARGET=127.0.0.1:5060
SIP_SERVICE=1000
SIP_TRANSPORT=udp
SIP_AUTH_USER=1234
SIP_AUTH_PASS=secret
SIP_CALL_DURATION=5

# Optional: pin bind address. Otherwise the NIC toward SIP_TARGET is used.
# SIP_LOCAL_IP=192.168.88.28
# Optional: skip STUN and advertise this IP in Contact/SDP.
# SIP_EXTERNAL_IP=123.24.143.114
# SIP_STUN=0
# SIP_STUN_SERVER=stun.l.google.com:19302
# SIP_HOLD_MS=30000
# SIP_DOMAIN=example.com
# SIP_LOCAL_PORT=5060
# SIP_MEDIA_PORT=6000
# SIP_DEBUG=1
